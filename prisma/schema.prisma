generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// Mirrors a Supabase auth.users row (id = auth user id) with app-level fields.
model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  posts                  Post[]
  enrollments            Enrollment[]
  courses                Course[]                 @relation("CourseInstructor")
  gameSessions           GameSession[]            @relation("GameSessionInstructor")
  participant            GameParticipant[]
  newsvendorSessions     NewsvendorSession[]      @relation("NewsvendorSessionInstructor")
  newsvendorParticipant  NewsvendorParticipant[]
  forecastingAttempts    ForecastingAttempt[]
  soloNewsvendorAttempts SoloNewsvendorAttempt[]
  fishBanksSessions      FishBanksSession[]       @relation("FishBanksSessionInstructor")
  fishBanksParticipant   FishBanksParticipant[]
  negotiationSessions    NegotiationSession[]     @relation("NegotiationSessionInstructor")
  negotiationParticipant NegotiationParticipant[]
  chats                  ChatMessage[]
  maizeyConversations    MaizeyConversation[]
}

model Topic {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?

  posts       Post[]
  courses     Course[]
  games       Game[]
  tutorTopics TutorTopic[]
}

model Post {
  id        String   @id @default(uuid())
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String
  author    Profile  @relation(fields: [authorId], references: [id])
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- Phase 3: courses & enrollment ---

model Course {
  id           String   @id @default(uuid())
  name         String
  term         String
  topic        Topic    @relation(fields: [topicId], references: [id])
  topicId      String
  instructor   Profile  @relation("CourseInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String   @unique
  createdAt    DateTime @default(now())

  enrollments         Enrollment[]
  gameSessions        GameSession[]
  newsvendorSessions  NewsvendorSession[]
  fishBanksSessions   FishBanksSession[]
  negotiationSessions NegotiationSession[]
  tutorTopics         TutorTopic[]
}

model Enrollment {
  id        String   @id @default(uuid())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  user      Profile  @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
}

// --- Phase 4: simulation games (Beer Game etc.) ---

enum GameCategory {
  SIMULATION
  SINGLE_PLAYER
  MULTI_PLAYER
}

model Game {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  topic       Topic        @relation(fields: [topicId], references: [id])
  topicId     String
  description String?
  category    GameCategory @default(SINGLE_PLAYER)

  sessions            GameSession[]
  newsvendorSessions  NewsvendorSession[]
  fishBanksSessions   FishBanksSession[]
  negotiationSessions NegotiationSession[]
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model GameSession {
  id           String        @id @default(uuid())
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String
  course       Course?       @relation(fields: [courseId], references: [id])
  courseId     String?
  instructor   Profile       @relation("GameSessionInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String        @unique
  status       SessionStatus @default(PENDING)
  // Kept for backwards compatibility and as the session-wide "furthest
  // round reached"; the authoritative per-team round is BeerTeam.currentRound,
  // since teams advance independently in a cohort.
  currentRound Int           @default(1)
  totalRounds  Int           @default(40)
  config       Json?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  participants  GameParticipant[]
  teams         BeerTeam[]
  roundStates   GameRoundState[]
  pendingOrders PendingOrder[]
}

// A single 4-role supply chain inside a session. One GameSession is a whole
// class (one join code); it holds as many BeerTeams as the roster divides
// into, so an instructor runs 50 students from one page instead of 13.
model BeerTeam {
  id           String      @id @default(uuid())
  session      GameSession @relation(fields: [sessionId], references: [id])
  sessionId    String
  name         String
  currentRound Int         @default(1)
  totalCost    Float       @default(0)
  createdAt    DateTime    @default(now())

  slots         BeerTeamSlot[]
  roundStates   GameRoundState[]
  pendingOrders PendingOrder[]

  @@unique([sessionId, name])
}

// One role on one team. Either a human (participantId set, isRobot false) or
// a "Beer-GPT" bot (participantId null, isRobot true). Modelling the seat
// rather than putting a role on GameParticipant is what makes host
// kick-to-robot and late-join-replaces-robot single-row updates, and avoids
// needing placeholder Profile rows for bots.
model BeerTeamSlot {
  id            String           @id @default(uuid())
  team          BeerTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  role          BeerGameRole
  participant   GameParticipant? @relation(fields: [participantId], references: [id])
  participantId String?          @unique
  isRobot       Boolean          @default(true)

  @@unique([teamId, role])
}

enum BeerGameRole {
  RETAILER
  WHOLESALER
  DISTRIBUTOR
  FACTORY
}

// Enrolment in the class, not a seat at a table. A participant has no role
// until the host starts the session and the cohort is drawn; the role then
// lives on their BeerTeamSlot.
model GameParticipant {
  id        String      @id @default(uuid())
  session   GameSession @relation(fields: [sessionId], references: [id])
  sessionId String
  user      Profile     @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime    @default(now())

  slot          BeerTeamSlot?
  roundStates   GameRoundState[]
  pendingOrders PendingOrder[]

  @@unique([sessionId, userId])
}

model GameRoundState {
  id               String           @id @default(uuid())
  session          GameSession      @relation(fields: [sessionId], references: [id])
  sessionId        String
  team             BeerTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId           String
  participant      GameParticipant? @relation(fields: [participantId], references: [id])
  participantId    String?
  role             BeerGameRole
  round            Int
  incomingOrder    Int
  incomingShipment Int
  shipped          Int
  outgoingOrder    Int
  inventory        Int
  backlog          Int
  cost             Float
  // True when this role was played by Beer-GPT for this round, so the
  // endgame report can count robots even after a slot is reassigned.
  wasRobot         Boolean          @default(false)

  // Uniqueness is per team, not per session — every team in a cohort has its
  // own RETAILER row for round 1.
  @@unique([teamId, role, round])
  @@index([sessionId, round])
}

// Stages a submitted order until every human slot on that team has one in
// for the round, at which point the engine resolves them into GameRoundState
// rows and these rows are deleted — keeps GameRoundState always
// fully-resolved. Robots never stage an order; they're derived at resolve.
model PendingOrder {
  id            String          @id @default(uuid())
  session       GameSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  team          BeerTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  participant   GameParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  amount        Int

  @@unique([participantId, round])
  @@index([teamId, round])
}

// --- Newsvendor game (Decision Sciences) ---
// Parallel to the Beer Game's tables above rather than sharing them: no
// fixed roles, any number of players, and every round draws a single
// shared demand value applied identically to all participants.

model NewsvendorSession {
  id           String        @id @default(uuid())
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String
  course       Course?       @relation(fields: [courseId], references: [id])
  courseId     String?
  instructor   Profile       @relation("NewsvendorSessionInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String        @unique
  status       SessionStatus @default(PENDING)
  currentRound Int           @default(1)
  totalRounds  Int           @default(8)
  price        Float         @default(5)
  cost         Float         @default(2)
  salvage      Float         @default(0)
  demandMin    Int           @default(10)
  demandMax    Int           @default(50)
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  participants  NewsvendorParticipant[]
  results       NewsvendorRoundResult[]
  pendingOrders NewsvendorPendingOrder[]
}

model NewsvendorParticipant {
  id        String            @id @default(uuid())
  session   NewsvendorSession @relation(fields: [sessionId], references: [id])
  sessionId String
  user      Profile           @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime          @default(now())

  results       NewsvendorRoundResult[]
  pendingOrders NewsvendorPendingOrder[]

  @@unique([sessionId, userId])
}

model NewsvendorRoundResult {
  id            String                @id @default(uuid())
  session       NewsvendorSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   NewsvendorParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  orderQty      Int
  demand        Int
  sold          Int
  leftover      Int
  shortage      Int
  profit        Float

  @@unique([participantId, round])
}

// Same staging pattern as the Beer Game's PendingOrder: an order sits
// here until every current participant has one in for the round, then
// the engine draws demand once and resolves everyone into
// NewsvendorRoundResult rows.
model NewsvendorPendingOrder {
  id            String                @id @default(uuid())
  session       NewsvendorSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   NewsvendorParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  amount        Int

  @@unique([participantId, round])
}

// --- Fish Banks classroom game (Decision Sciences) ---
// A simplified version of MIT's "Fishbanks, Ltd." simulation: teams run
// competing fishing companies drawing from two shared, regenerating fish
// stocks (coastal + deep sea) tracked on the session itself, rather than
// per-participant like the Beer Game's fixed roles — any number of teams
// can join. Resolution logic lives in src/lib/fishBanks.ts.

model FishBanksSession {
  id           String        @id @default(uuid())
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String
  course       Course?       @relation(fields: [courseId], references: [id])
  courseId     String?
  instructor   Profile       @relation("FishBanksSessionInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String        @unique
  status       SessionStatus @default(PENDING)
  currentRound Int           @default(1)
  totalRounds  Int           @default(15)
  coastalStock Float         @default(400)
  deepSeaStock Float         @default(1200)
  config       Json?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  participants     FishBanksParticipant[]
  teamRounds       FishBanksTeamRound[]
  marketRounds     FishBanksMarketRound[]
  pendingDecisions FishBanksPendingDecision[]
}

model FishBanksParticipant {
  id          String           @id @default(uuid())
  session     FishBanksSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  user        Profile          @relation(fields: [userId], references: [id])
  userId      String
  companyName String
  cash        Float
  ships       Int
  joinedAt    DateTime         @default(now())

  rounds           FishBanksTeamRound[]
  pendingDecisions FishBanksPendingDecision[]

  @@unique([sessionId, userId])
}

// Staged the same way as PendingOrder / NewsvendorPendingOrder: a
// team's decision sits here until every current participant has one in
// for the round (or the instructor force-resolves), at which point the
// engine resolves everyone into FishBanksTeamRound rows and this row is
// deleted.
model FishBanksPendingDecision {
  id            String               @id @default(uuid())
  session       FishBanksSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   FishBanksParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  shipsCoastal  Int
  shipsDeepSea  Int
  buildShips    Int
  scrapShips    Int

  @@unique([participantId, round])
}

model FishBanksTeamRound {
  id            String               @id @default(uuid())
  session       FishBanksSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   FishBanksParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  shipsCoastal  Int
  shipsDeepSea  Int
  shipsBuilt    Int
  shipsScrapped Int
  catchCoastal  Float
  catchDeepSea  Float
  revenue       Float
  operatingCost Float
  buildCost     Float
  scrapRevenue  Float
  interest      Float
  profit        Float
  cash          Float // ending balance
  ships         Int // ending fleet size
  netWorth      Float // ending cash + fleet at scrap value

  @@unique([participantId, round])
}

// One row per session per round: the shared stock/price state everyone
// was fishing against, kept for the end-of-game chart.
model FishBanksMarketRound {
  id           String           @id @default(uuid())
  session      FishBanksSession @relation(fields: [sessionId], references: [id])
  sessionId    String
  round        Int
  coastalStock Float
  deepSeaStock Float
  price        Float
  totalCatch   Float

  @@unique([sessionId, round])
}

// --- Supply Chain Sourcing Game / negotiation (Supply Chain Management) ---
// Online adaptation of the classroom exercise in Gumus & Love, "Supply Chain
// Sourcing Game: A Negotiation Exercise", Decision Sciences Journal of
// Innovative Education 11(1), 3-12 (2013), DOI 10.1111/j.1540-4609.2012.00368.x.
// Independent implementation from the paper's description; no code or text
// was taken from it. Default parameters mirror the paper's Figures 3-4 and are
// host-editable. Resolution logic lives in src/lib/negotiation.ts.
//
// Unlike Fish Banks/Newsvendor, a "round" here is a negotiation attempt over
// ONE contract covering the whole planning horizon, not a production period —
// profit is computed once, at settlement, not accumulated round over round.

enum NegotiationRole {
  RETAILER
  WHOLESALER
}

enum NegotiationStage {
  RFQ // retailers submitting their request for quotation
  NEGOTIATION // k rounds of wholesaler proposal / retailer response
  SETTLEMENT // wholesalers submitting manufacturer procurement schedules
}

enum NegotiationDyadStatus {
  AWAITING_RFQ
  NEGOTIATING
  AGREED
  NO_DEAL
}

enum NegotiationResponseKind {
  ACCEPT
  REVISE
  REJECT // final-round rejection: ends without a contract
}

model NegotiationSession {
  id              String           @id @default(uuid())
  game            Game             @relation(fields: [gameId], references: [id])
  gameId          String
  course          Course?          @relation(fields: [courseId], references: [id])
  courseId        String?
  instructor      Profile          @relation("NegotiationSessionInstructor", fields: [instructorId], references: [id])
  instructorId    String
  joinCode        String           @unique
  status          SessionStatus    @default(PENDING)
  stage           NegotiationStage @default(RFQ)
  currentRound    Int              @default(1)
  totalRounds     Int              @default(3)
  roundDeadlineAt DateTime? // advisory only — there is no cron/realtime to enforce it; see src/lib/negotiation.ts
  config          Json?
  createdAt       DateTime         @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  participants NegotiationParticipant[]
  dyads        NegotiationDyad[]
  rounds       NegotiationRound[]
  outcomes     NegotiationOutcome[]
}

// Enrolment in the class, not a seat at a table: role is implied by which FK
// on NegotiationDyad points here, and is unset until the host starts and
// dyads are drawn.
model NegotiationParticipant {
  id        String             @id @default(uuid())
  session   NegotiationSession @relation(fields: [sessionId], references: [id])
  sessionId String
  user      Profile            @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime           @default(now())

  retailerSeat   NegotiationDyad?     @relation("NegotiationDyadRetailer")
  wholesalerSeat NegotiationDyad?     @relation("NegotiationDyadWholesaler")
  outcomes       NegotiationOutcome[]

  @@unique([sessionId, userId])
}

// One retailer/wholesaler pair, fixed for the whole game — "each retailer...
// negotiates with a single wholesaler" (paper, p.4). A null participant FK is
// a bot seat; Postgres treats NULLs as distinct in a unique index, so @unique
// still allows any number of bot seats while making a double-claim a P2002
// and guaranteeing nobody holds two seats.
model NegotiationDyad {
  id                      String                  @id @default(uuid())
  session                 NegotiationSession      @relation(fields: [sessionId], references: [id])
  sessionId               String
  dyadNumber              Int
  retailerFirmName        String
  wholesalerFirmName      String
  retailer                NegotiationParticipant? @relation("NegotiationDyadRetailer", fields: [retailerParticipantId], references: [id])
  retailerParticipantId   String?                 @unique
  wholesaler              NegotiationParticipant? @relation("NegotiationDyadWholesaler", fields: [wholesalerParticipantId], references: [id])
  wholesalerParticipantId String?                 @unique
  status                  NegotiationDyadStatus   @default(AWAITING_RFQ)

  rfqQuantities       Json? // number[], one per horizon month — the Fig. 6 RFQ
  demandShared        Boolean  @default(false)
  agreedPrice         Float?
  agreedQuantities    Json? // number[] — per-month supply, once agreed
  agreedAtRound       Int?
  procurementSchedule Json? // number[] — wholesaler's manufacturer order schedule
  createdAt           DateTime @default(now())

  rounds   NegotiationRound[]
  outcomes NegotiationOutcome[]
  result   NegotiationDyadResult?

  @@unique([sessionId, dyadNumber])
}

// Both the staging row the stage-advance threshold counts AND the permanent
// transcript — the wholesaler's proposal and the retailer's response, i.e.
// the paper's single sheet of paper written on both sides (pp. 8-9). Rows
// are created eagerly (one per dyad per round) and never deleted.
model NegotiationRound {
  id        String             @id @default(uuid())
  session   NegotiationSession @relation(fields: [sessionId], references: [id])
  sessionId String
  dyad      NegotiationDyad    @relation(fields: [dyadId], references: [id], onDelete: Cascade)
  dyadId    String
  round     Int

  proposalPrice      Float?
  proposalQuantities Json?
  proposalNote       String?
  proposalByBot      Boolean   @default(false)
  proposedAt         DateTime?

  responseKind        NegotiationResponseKind?
  requestedPrice      Float?
  requestedQuantities Json?
  responseNote        String?
  responseByBot       Boolean                  @default(false)
  respondedAt         DateTime?

  createdAt DateTime @default(now())

  @@unique([dyadId, round])
  @@index([sessionId, round])
}

// One row per seat, computed once at settlement. @@unique([dyadId, role]) is
// the concurrency barrier for the stage-advance race — both columns are
// NOT NULL, unlike participantId (which is null for a bot seat and therefore
// cannot serve as a unique-constraint barrier: Postgres treats NULLs as
// distinct, so two racing resolvers writing bot rows would both succeed).
model NegotiationOutcome {
  id              String                  @id @default(uuid())
  session         NegotiationSession      @relation(fields: [sessionId], references: [id])
  sessionId       String
  dyad            NegotiationDyad         @relation(fields: [dyadId], references: [id], onDelete: Cascade)
  dyadId          String
  participant     NegotiationParticipant? @relation(fields: [participantId], references: [id])
  participantId   String?
  role            NegotiationRole
  isBot           Boolean                 @default(false)
  dealt           Boolean
  agreedPrice     Float?
  unitsContracted Int
  unitsSold       Int
  unmetDemand     Int
  endingInventory Int
  revenue         Float
  goodsCost       Float
  orderingCost    Float
  holdingCost     Float
  salvageRevenue  Float
  profit          Float

  @@unique([dyadId, role])
  @@index([sessionId])
}

// Chain-level debrief numbers. The negotiated price is a pure transfer, so
// chainProfit does not depend on it — the headline teaching point, made
// concrete by comparing against centralizedProfit (the vertically-integrated
// first-best, computed by src/lib/negotiation.ts's centralizedOptimum).
model NegotiationDyadResult {
  id                String          @id @default(uuid())
  dyad              NegotiationDyad @relation(fields: [dyadId], references: [id], onDelete: Cascade)
  dyadId            String          @unique
  dealt             Boolean
  chainProfit       Float
  centralizedProfit Float
  coordinationLoss  Float
  efficiency        Float
  deliveryCount     Int
  procurementCount  Int
}

// --- Forecasting practice game (Decision Sciences) ---
// Single-player, no session/join-code — open-ended practice. Correctness
// is computed client-side from the (non-secret, formula-based) engine in
// src/lib/forecasting.ts; each row here is just a logged attempt for the
// student's own history and, for instructors, a class-wide view.

enum ForecastMethod {
  SMA3
  SMA4
  WMA
  EXP_SMOOTHING
  LINEAR_REGRESSION
}

model ForecastingAttempt {
  id              String         @id @default(uuid())
  user            Profile        @relation(fields: [userId], references: [id])
  userId          String
  method          ForecastMethod
  datasetSlug     String
  userForecast    Float
  correctForecast Float
  percentError    Float
  score           Int
  createdAt       DateTime       @default(now())
}

// --- Newsvendor Practice (single-player, Decision Sciences) ---
// A solo variant of the multiplayer NewsvendorSession above, reusing the
// same engine (src/lib/newsvendor.ts) but with no session/join-code —
// each round is independent. Unlike ForecastingAttempt, demand here is
// randomly drawn per round rather than a public formula, so it's drawn
// server-side (see newsvendor-solo-actions.ts) rather than client-side.

model SoloNewsvendorAttempt {
  id           String   @id @default(uuid())
  user         Profile  @relation(fields: [userId], references: [id])
  userId       String
  scenarioSlug String
  orderQty     Int
  demand       Int
  sold         Int
  leftover     Int
  shortage     Int
  profit       Float
  createdAt    DateTime @default(now())
}

// --- Phase 5: AI tutor chatbots ---
// A tutor binds to either a Topic (open site-wide) or a Course
// (gated to its roster) — never both, enforced in the create action
// rather than a DB constraint.

// Custom RAG (our own materials + pgvector retrieval) is the default.
// Maizey forks the whole tutor out to a separate, already-existing Maizey
// project: no materials of ours involved, no retrieval of ours involved —
// see maizeyProjectId below and src/lib/maizey.ts.
enum TutorProvider {
  CUSTOM_RAG
  MAIZEY
}

model TutorTopic {
  id              String        @id @default(uuid())
  topic           Topic?        @relation(fields: [topicId], references: [id])
  topicId         String?
  course          Course?       @relation(fields: [courseId], references: [id])
  courseId        String?
  name            String
  // Required for CUSTOM_RAG (it's what renderSystemPrompt uses); left
  // null for MAIZEY — the persona lives in the Maizey project itself.
  systemPrompt    String?
  provider        TutorProvider @default(CUSTOM_RAG)
  // Set only when provider = MAIZEY. The id of an existing Maizey
  // "Project" (its knowledge base lives there, managed in Maizey's own
  // UI — not through us) that this tutor's chat forwards to instead of
  // running our own retrieval.
  maizeyProjectId String?
  // Encrypted (AES-256-GCM, see src/lib/crypto.ts) Maizey API token
  // belonging to *this tutor's* instructor. Each instructor has their
  // own separate Maizey account — there is no single shared token that
  // can reach every instructor's projects, unlike TUTOR_API_KEY for
  // our own gateway.
  maizeyApiToken  String?
  createdAt       DateTime      @default(now())

  materials           TutorMaterial[]
  messages            ChatMessage[]
  maizeyConversations MaizeyConversation[]
}

enum MaterialType {
  TXT
  DOCX
  PPTX
  PDF
}

enum MaterialStatus {
  PENDING
  READY
  FAILED
}

// A source document a tutor is grounded in. Text is extracted once on
// upload, split into MaterialChunk rows, and embedded — chat answers
// are only allowed to draw on these chunks, not general knowledge.
model TutorMaterial {
  id           String         @id @default(uuid())
  tutorTopic   TutorTopic     @relation(fields: [tutorTopicId], references: [id])
  tutorTopicId String
  fileName     String
  storagePath  String
  fileType     MaterialType
  status       MaterialStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime       @default(now())

  chunks MaterialChunk[]
}

// embedding has no Prisma-native query support (no cosine-distance
// operator in the query builder) — similarity search is done via
// $queryRaw using pgvector's `<=>` operator directly.
model MaterialChunk {
  id         String                      @id @default(uuid())
  material   TutorMaterial               @relation(fields: [materialId], references: [id])
  materialId String
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id           String     @id @default(uuid())
  tutorTopic   TutorTopic @relation(fields: [tutorTopicId], references: [id])
  tutorTopicId String
  user         Profile    @relation(fields: [userId], references: [id])
  userId       String
  role         ChatRole
  content      String
  createdAt    DateTime   @default(now())
}

// Maizey has no endpoint to list or resume a conversation — the pk it
// hands back from POST .../conversation/ has to be remembered on our
// side, one per (tutor, student) pair, so a student's second message
// reuses the same conversation instead of starting a fresh one (and
// losing prior turns on Maizey's side) every time.
model MaizeyConversation {
  id             String     @id @default(uuid())
  tutorTopic     TutorTopic @relation(fields: [tutorTopicId], references: [id])
  tutorTopicId   String
  user           Profile    @relation(fields: [userId], references: [id])
  userId         String
  conversationPk String
  createdAt      DateTime   @default(now())

  @@unique([tutorTopicId, userId])
}

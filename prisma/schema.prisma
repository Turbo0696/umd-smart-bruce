generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

// Mirrors a Supabase auth.users row (id = auth user id) with app-level fields.
model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  posts                    Post[]
  enrollments              Enrollment[]
  courses                  Course[]                 @relation("CourseInstructor")
  gameSessions             GameSession[]            @relation("GameSessionInstructor")
  participant              GameParticipant[]
  newsvendorSessions       NewsvendorSession[]       @relation("NewsvendorSessionInstructor")
  newsvendorParticipant    NewsvendorParticipant[]
  forecastingAttempts      ForecastingAttempt[]
  soloNewsvendorAttempts   SoloNewsvendorAttempt[]
  fishBanksSessions        FishBanksSession[]        @relation("FishBanksSessionInstructor")
  fishBanksParticipant     FishBanksParticipant[]
  chats                    ChatMessage[]
}

model Topic {
  id          String  @id @default(uuid())
  slug        String  @unique
  name        String
  description String?

  posts       Post[]
  courses     Course[]
  games       Game[]
  tutorTopics TutorTopic[]
}

model Post {
  id        String   @id @default(uuid())
  topic     Topic    @relation(fields: [topicId], references: [id])
  topicId   String
  author    Profile  @relation(fields: [authorId], references: [id])
  authorId  String
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- Phase 3: courses & enrollment ---

model Course {
  id           String   @id @default(uuid())
  name         String
  term         String
  topic        Topic    @relation(fields: [topicId], references: [id])
  topicId      String
  instructor   Profile  @relation("CourseInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String   @unique
  createdAt    DateTime @default(now())

  enrollments        Enrollment[]
  gameSessions       GameSession[]
  newsvendorSessions NewsvendorSession[]
  fishBanksSessions  FishBanksSession[]
  tutorTopics        TutorTopic[]
}

model Enrollment {
  id        String   @id @default(uuid())
  course    Course   @relation(fields: [courseId], references: [id])
  courseId  String
  user      Profile  @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
}

// --- Phase 4: simulation games (Beer Game etc.) ---

enum GameCategory {
  SIMULATION
  SINGLE_PLAYER
  MULTI_PLAYER
}

model Game {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  topic       Topic        @relation(fields: [topicId], references: [id])
  topicId     String
  description String?
  category    GameCategory @default(SINGLE_PLAYER)

  sessions           GameSession[]
  newsvendorSessions NewsvendorSession[]
  fishBanksSessions  FishBanksSession[]
}

enum SessionStatus {
  PENDING
  ACTIVE
  COMPLETED
}

model GameSession {
  id           String        @id @default(uuid())
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String
  course       Course?       @relation(fields: [courseId], references: [id])
  courseId     String?
  instructor   Profile       @relation("GameSessionInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String        @unique
  status       SessionStatus @default(PENDING)
  currentRound Int           @default(1)
  totalRounds  Int           @default(20)
  config       Json?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  participants GameParticipant[]
  roundStates  GameRoundState[]
  pendingOrders PendingOrder[]
}

enum BeerGameRole {
  RETAILER
  WHOLESALER
  DISTRIBUTOR
  FACTORY
}

model GameParticipant {
  id        String       @id @default(uuid())
  session   GameSession  @relation(fields: [sessionId], references: [id])
  sessionId String
  user      Profile      @relation(fields: [userId], references: [id])
  userId    String
  role      BeerGameRole

  roundStates   GameRoundState[]
  pendingOrders PendingOrder[]

  @@unique([sessionId, userId])
}

model GameRoundState {
  id               String           @id @default(uuid())
  session          GameSession      @relation(fields: [sessionId], references: [id])
  sessionId        String
  participant      GameParticipant? @relation(fields: [participantId], references: [id])
  participantId    String?
  role             BeerGameRole
  round            Int
  incomingOrder    Int
  incomingShipment Int
  shipped          Int
  outgoingOrder    Int
  inventory        Int
  backlog          Int
  cost             Float

  @@unique([sessionId, role, round])
}

// Stages a submitted order until all 4 participants have one in for the
// round, at which point the engine resolves them into GameRoundState rows
// and this row is deleted — keeps GameRoundState always fully-resolved.
model PendingOrder {
  id            String          @id @default(uuid())
  session       GameSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   GameParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  amount        Int

  @@unique([participantId, round])
}

// --- Newsvendor game (Decision Sciences) ---
// Parallel to the Beer Game's tables above rather than sharing them: no
// fixed roles, any number of players, and every round draws a single
// shared demand value applied identically to all participants.

model NewsvendorSession {
  id           String        @id @default(uuid())
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String
  course       Course?       @relation(fields: [courseId], references: [id])
  courseId     String?
  instructor   Profile       @relation("NewsvendorSessionInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String        @unique
  status       SessionStatus @default(PENDING)
  currentRound Int           @default(1)
  totalRounds  Int           @default(8)
  price        Float         @default(5)
  cost         Float         @default(2)
  salvage      Float         @default(0)
  demandMin    Int           @default(10)
  demandMax    Int           @default(50)
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  participants  NewsvendorParticipant[]
  results       NewsvendorRoundResult[]
  pendingOrders NewsvendorPendingOrder[]
}

model NewsvendorParticipant {
  id        String            @id @default(uuid())
  session   NewsvendorSession @relation(fields: [sessionId], references: [id])
  sessionId String
  user      Profile           @relation(fields: [userId], references: [id])
  userId    String
  joinedAt  DateTime          @default(now())

  results       NewsvendorRoundResult[]
  pendingOrders NewsvendorPendingOrder[]

  @@unique([sessionId, userId])
}

model NewsvendorRoundResult {
  id            String                @id @default(uuid())
  session       NewsvendorSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   NewsvendorParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  orderQty      Int
  demand        Int
  sold          Int
  leftover      Int
  shortage      Int
  profit        Float

  @@unique([participantId, round])
}

// Same staging pattern as the Beer Game's PendingOrder: an order sits
// here until every current participant has one in for the round, then
// the engine draws demand once and resolves everyone into
// NewsvendorRoundResult rows.
model NewsvendorPendingOrder {
  id            String                @id @default(uuid())
  session       NewsvendorSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   NewsvendorParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  amount        Int

  @@unique([participantId, round])
}

// --- Fish Banks classroom game (Decision Sciences) ---
// A simplified version of MIT's "Fishbanks, Ltd." simulation: teams run
// competing fishing companies drawing from two shared, regenerating fish
// stocks (coastal + deep sea) tracked on the session itself, rather than
// per-participant like the Beer Game's fixed roles — any number of teams
// can join. Resolution logic lives in src/lib/fishBanks.ts.

model FishBanksSession {
  id           String        @id @default(uuid())
  game         Game          @relation(fields: [gameId], references: [id])
  gameId       String
  course       Course?       @relation(fields: [courseId], references: [id])
  courseId     String?
  instructor   Profile       @relation("FishBanksSessionInstructor", fields: [instructorId], references: [id])
  instructorId String
  joinCode     String        @unique
  status       SessionStatus @default(PENDING)
  currentRound Int           @default(1)
  totalRounds  Int           @default(15)
  coastalStock Float         @default(400)
  deepSeaStock Float         @default(1200)
  config       Json?
  createdAt    DateTime      @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  participants     FishBanksParticipant[]
  teamRounds       FishBanksTeamRound[]
  marketRounds     FishBanksMarketRound[]
  pendingDecisions FishBanksPendingDecision[]
}

model FishBanksParticipant {
  id          String           @id @default(uuid())
  session     FishBanksSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  user        Profile          @relation(fields: [userId], references: [id])
  userId      String
  companyName String
  cash        Float
  ships       Int
  joinedAt    DateTime         @default(now())

  rounds           FishBanksTeamRound[]
  pendingDecisions FishBanksPendingDecision[]

  @@unique([sessionId, userId])
}

// Staged the same way as PendingOrder / NewsvendorPendingOrder: a
// team's decision sits here until every current participant has one in
// for the round (or the instructor force-resolves), at which point the
// engine resolves everyone into FishBanksTeamRound rows and this row is
// deleted.
model FishBanksPendingDecision {
  id            String               @id @default(uuid())
  session       FishBanksSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   FishBanksParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  shipsCoastal  Int
  shipsDeepSea  Int
  buildShips    Int
  scrapShips    Int

  @@unique([participantId, round])
}

model FishBanksTeamRound {
  id            String               @id @default(uuid())
  session       FishBanksSession     @relation(fields: [sessionId], references: [id])
  sessionId     String
  participant   FishBanksParticipant @relation(fields: [participantId], references: [id])
  participantId String
  round         Int
  shipsCoastal  Int
  shipsDeepSea  Int
  shipsBuilt    Int
  shipsScrapped Int
  catchCoastal  Float
  catchDeepSea  Float
  revenue       Float
  operatingCost Float
  buildCost     Float
  scrapRevenue  Float
  interest      Float
  profit        Float
  cash          Float // ending balance
  ships         Int // ending fleet size
  netWorth      Float // ending cash + fleet at scrap value

  @@unique([participantId, round])
}

// One row per session per round: the shared stock/price state everyone
// was fishing against, kept for the end-of-game chart.
model FishBanksMarketRound {
  id           String           @id @default(uuid())
  session      FishBanksSession @relation(fields: [sessionId], references: [id])
  sessionId    String
  round        Int
  coastalStock Float
  deepSeaStock Float
  price        Float
  totalCatch   Float

  @@unique([sessionId, round])
}

// --- Forecasting practice game (Decision Sciences) ---
// Single-player, no session/join-code — open-ended practice. Correctness
// is computed client-side from the (non-secret, formula-based) engine in
// src/lib/forecasting.ts; each row here is just a logged attempt for the
// student's own history and, for instructors, a class-wide view.

enum ForecastMethod {
  SMA3
  SMA4
  WMA
  EXP_SMOOTHING
  LINEAR_REGRESSION
}

model ForecastingAttempt {
  id              String         @id @default(uuid())
  user            Profile        @relation(fields: [userId], references: [id])
  userId          String
  method          ForecastMethod
  datasetSlug     String
  userForecast    Float
  correctForecast Float
  percentError    Float
  score           Int
  createdAt       DateTime       @default(now())
}

// --- Newsvendor Practice (single-player, Decision Sciences) ---
// A solo variant of the multiplayer NewsvendorSession above, reusing the
// same engine (src/lib/newsvendor.ts) but with no session/join-code —
// each round is independent. Unlike ForecastingAttempt, demand here is
// randomly drawn per round rather than a public formula, so it's drawn
// server-side (see newsvendor-solo-actions.ts) rather than client-side.

model SoloNewsvendorAttempt {
  id           String   @id @default(uuid())
  user         Profile  @relation(fields: [userId], references: [id])
  userId       String
  scenarioSlug String
  orderQty     Int
  demand       Int
  sold         Int
  leftover     Int
  shortage     Int
  profit       Float
  createdAt    DateTime @default(now())
}

// --- Phase 5: AI tutor chatbots ---
// A tutor binds to either a Topic (open site-wide) or a Course
// (gated to its roster) — never both, enforced in the create action
// rather than a DB constraint.

model TutorTopic {
  id           String   @id @default(uuid())
  topic        Topic?   @relation(fields: [topicId], references: [id])
  topicId      String?
  course       Course?  @relation(fields: [courseId], references: [id])
  courseId     String?
  name         String
  systemPrompt String
  createdAt    DateTime @default(now())

  materials TutorMaterial[]
  messages  ChatMessage[]
}

enum MaterialType {
  TXT
  DOCX
  PPTX
  PDF
}

enum MaterialStatus {
  PENDING
  READY
  FAILED
}

// A source document a tutor is grounded in. Text is extracted once on
// upload, split into MaterialChunk rows, and embedded — chat answers
// are only allowed to draw on these chunks, not general knowledge.
model TutorMaterial {
  id           String         @id @default(uuid())
  tutorTopic   TutorTopic     @relation(fields: [tutorTopicId], references: [id])
  tutorTopicId String
  fileName     String
  storagePath  String
  fileType     MaterialType
  status       MaterialStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime       @default(now())

  chunks MaterialChunk[]
}

// embedding has no Prisma-native query support (no cosine-distance
// operator in the query builder) — similarity search is done via
// $queryRaw using pgvector's `<=>` operator directly.
model MaterialChunk {
  id         String                      @id @default(uuid())
  material   TutorMaterial               @relation(fields: [materialId], references: [id])
  materialId String
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(1536)")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id           String     @id @default(uuid())
  tutorTopic   TutorTopic @relation(fields: [tutorTopicId], references: [id])
  tutorTopicId String
  user         Profile    @relation(fields: [userId], references: [id])
  userId       String
  role         ChatRole
  content      String
  createdAt    DateTime   @default(now())
}

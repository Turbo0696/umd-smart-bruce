# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Same, but without the leading dot — how these files often arrive by
# email or chat. `.env*` does not match them, so they need their own rule.
/env
/env.*

# local notes with live credentials — never commit
demo-accounts.md

# course material files staged locally for testing — not part of the repo
/materials/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Supabase project (Phase 2+) ---
# From the project's "Connect" panel: DATABASE_URL is the transaction-mode
# pooler (port 6543, pgbouncer=true) used by the app at runtime; DIRECT_URL
# is the session-mode pooler (port 5432) used only by Prisma CLI migrations.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- AI Tutor gateway (Phase 5) ---
# Anthropic-native gateway: base URL + key for the third-party proxy.
TUTOR_API_BASE_URL=""
TUTOR_API_KEY=""
TUTOR_MODEL=""

# --- Maizey (per-tutor provider fork; base URL is fixed, see src/lib/maizey.ts) ---
# Per-tutor: each instructor pastes their own token in the tutor form; not
# a shared server credential like the ones above.
MAIZEY_TOKEN_ENCRYPTION_KEY=""  # openssl rand -hex 32

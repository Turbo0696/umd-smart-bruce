# --- Supabase project (Phase 2+) ---
# Project Settings > Database > Connection string (use the pooled "Transaction" URL for DATABASE_URL,
# and the direct connection for DIRECT_URL if you add one later for migrations).
DATABASE_URL="postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# --- AI Tutor gateway (Phase 5) ---
# Anthropic-native gateway: base URL + key for the third-party proxy.
TUTOR_API_BASE_URL=""
TUTOR_API_KEY=""
TUTOR_MODEL=""
